FROM node:22.15.1-alpine

WORKDIR /app

# Nur Abhängigkeiten kopieren für effizientes Caching
COPY package.json yarn.lock* package-lock.json* pnpm-lock.yaml* ./
COPY vendor ./vendor
RUN npm install

# Restlichen Code kopieren
COPY . .

EXPOSE 3000

# Next.js im Dev-Modus starten
CMD ["npm", "run", "dev"]